# ============================================================
# RevOps Lead Scoring Platform — Environment Template
# Copy to .env and fill in values. Never commit .env to VCS.
# ============================================================

# ---- Application ----
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-use-openssl-rand-hex-32
APP_DEBUG=true
LOG_LEVEL=INFO

# ---- Database (PostgreSQL / Neon) ----
DATABASE_URL=postgresql+psycopg2://revops:revops_pass@localhost:5432/revops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ---- Redis (broker + cache) ----
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_DB=1
REDIS_LOCK_TTL_SECONDS=300

# ---- Auth / JWT ----
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Admin seed user (used by CLI only) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ---- HubSpot ----
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_RATE_LIMIT_PER_SECOND=10
HUBSPOT_BATCH_SIZE=100

# ---- Celery ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# ---- Object Storage (S3-compatible) ----
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_RAW=revops-raw-imports
S3_BUCKET_EXPORTS=revops-exports
S3_REGION=us-east-1

# ---- Scoring Engine ----
SCORING_MODEL_VERSION=1.0.0
SCORING_BATCH_SIZE=500
SCORING_SHADOW_MODEL_VERSION=
SCORING_HOT_THRESHOLD=75
SCORING_WARM_THRESHOLD=50
SCORING_COOL_THRESHOLD=25

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# ---- Observability ----
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================
# NEW FEATURES (v2) — fill in to enable
# ============================================================

# ---- AI Lead Intelligence (Feature 5) ----
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
AI_INTELLIGENCE_CACHE_TTL_SECONDS=21600
AI_INTELLIGENCE_RATE_LIMIT_PER_MINUTE=10

# ---- Salesforce Integration (Feature 4) ----
# Create a Connected App in Salesforce Setup → App Manager
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/salesforce/oauth/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# ---- HubSpot Webhook Secret (Feature 2) ----
# Set in HubSpot Workflows → Webhook → Secret key
HUBSPOT_WEBHOOK_SECRET=

# ---- ML Model Storage (Feature 1) ----
ML_MODELS_DIR=data/models

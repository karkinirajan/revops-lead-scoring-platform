# Copy to .env and fill in. .env is never committed. APP_ENV=production refuses placeholder secrets (see apps/api/app/config.py).
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- Application ----
APP_ENV=development            # development | staging | production
APP_SECRET_KEY=insecure-dev-secret-change-me       # encrypts stored CRM tokens; changing it makes them unreadable. >= 32 chars outside development
APP_DEBUG=false
LOG_LEVEL=INFO

# ---- Auth ----
JWT_SECRET_KEY=insecure-dev-jwt-secret-change-me   # >= 32 chars outside development
JWT_ALGORITHM=HS256            # HS256 | HS384 | HS512
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
ADMIN_EMAIL=admin@example.com                      # created by `make seed`
ADMIN_PASSWORD=change-me-strong-password           # replace outside development

# ---- Database / queue (docker compose overrides these for its own services) ----
POSTGRES_PASSWORD=revops_pass
DATABASE_URL=postgresql+psycopg2://revops:revops_pass@localhost:5432/revops
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Production only (docker-compose.prod.yml):
# POSTGRES_USER=revops
# POSTGRES_DB=revops
# REDIS_PASSWORD=

# ---- Web / CORS ----
CORS_ORIGINS=http://localhost:3000                 # comma separated; '*' is refused outside development
API_INTERNAL_URL=http://localhost:8000             # where the web app's server reaches the API (docker compose sets http://api:8000)
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_LOGIN_PER_MINUTE=10

# ---- HubSpot ----
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_WEBHOOK_SECRET=        # the HubSpot app's client secret: the deal-won webhook (/api/v1/analytics/conversions/hubspot) is off without it
PUBLIC_API_URL=                # https://api.example.com : the URL HubSpot calls, needed to check its signature behind a proxy

# ---- Salesforce (OAuth) ----
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_ALLOWED_DOMAINS=.salesforce.com,.force.com

# ---- Webhooks ----
WEBHOOK_ALLOW_PRIVATE_TARGETS=false   # true lets webhooks call localhost / private addresses over http (local testing only)

# ---- AI (Claude) ----
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_INTELLIGENCE_RATE_LIMIT_PER_MINUTE=10

# ---- Machine-learning model ----
ML_MODELS_DIR=data/models      # XGBoost .json models are loaded from here, and nowhere else
SCORING_MODEL_VERSION=1.0.0

# ---- Object storage (optional, for S3 imports) ----
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

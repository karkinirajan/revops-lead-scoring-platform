# =============================================================
# RevOps Lead Scoring Platform — .gitignore
# =============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.virtualenv/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover
*.coverprofile
junit*.xml

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# Celery
celerybeat-schedule
celerybeat.pid

# ---- Node.js / Next.js ----
node_modules/
.next/
out/
.nuxt/
dist/
*.tsbuildinfo
.turbo/
.vercel/

# Logs (npm/yarn/pnpm)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ---- Environment / secrets ----
# All .env files are secret — only the example template is tracked.
.env
.env.*
!.env.example
!.env.*.example

# Next.js local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---- Data directories ----
# Raw imports, processed exports, and temp files stay local.
data/raw/*
data/processed/*
data/exports/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/exports/.gitkeep

# ---- Build / compiled output ----
*.pyc
*.pyo
*.whl
*.tar.gz
*.zip

# ---- Logs ----
logs/
*.log
*.log.*

# ---- Secrets / certificates ----
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
certs/
infra/nginx/certs/

# ---- Docker local state ----
.docker/

# ---- Databases (local dev only) ----
*.db
*.sqlite
*.sqlite3

# ---- IDE / editors ----
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# ---- OS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---- Misc ----
.cache/
tmp/
temp/
scratch/

# Web (Next.js)
apps/web/coverage/
apps/web/next-env.d.ts
